class Rectangle:
    def __init__(self, length, breadth):
        self.length = length
        self.breadth = breadth

    def area(self):
        print("Area =", self.length * self.breadth)

    def perimeter(self):
        print("Perimeter =", 2 * (self.length + self.breadth))


# Creating object
r1 = Rectangle(10, 5)

# Calling methods
r1.area()
r1.perimeter()
